#!/bin/bash
set -euxo pipefail

# Install Docker and the Compose plugin
dnf install -y docker
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# Work out this server's public address (IMDSv2) and turn it into an HTTPS hostname
TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
PUBLIC_IP=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/public-ipv4)
HOST=$(echo "$PUBLIC_IP" | tr . -).sslip.io

mkdir -p /opt/cyberquest
cd /opt/cyberquest

# Secrets and settings (generated by Terraform on each run)
cat > .env <<ENV
SECRET_KEY=${secret_key}
DATABASE_URL=postgresql://cyberquest:${db_password}@db:5432/cyberquest
POSTGRES_DB=cyberquest
POSTGRES_USER=cyberquest
POSTGRES_PASSWORD=${db_password}
SITE_HOST=$HOST
ENV
chmod 600 .env

cat > Caddyfile <<'CADDY'
{$SITE_HOST} {
    reverse_proxy app:5000
}
CADDY

cat > docker-compose.yml <<'COMPOSE'
services:
  app:
    image: ${image}
    restart: unless-stopped
    env_file: .env
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/health', timeout=3)"
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

  db:
    image: postgres:16-alpine
    restart: unless-stopped
    env_file: .env
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U cyberquest -d cyberquest"]
      interval: 5s
      timeout: 5s
      retries: 10

  caddy:
    image: caddy:2
    restart: unless-stopped
    env_file: .env
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - app

volumes:
  postgres_data:
  caddy_data:
  caddy_config:
COMPOSE

docker compose pull
docker compose up -d